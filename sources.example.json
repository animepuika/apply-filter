  "_finding_a_slug": [
    "Open a company's careers page and read the URL.",
    "  boards.greenhouse.io/<slug>      -> greenhouse",
    "  jobs.lever.co/<slug>             -> lever",
    "  jobs.ashbyhq.com/<slug>          -> ashby",
    "  <slug>.teamtailor.com            -> teamtailor",
    "  <slug>.recruitee.com             -> recruitee",
    "  apply.workable.com/<slug>        -> workable",
    "Teamtailor is worth trying on any smaller European employer. Its feed",
    "lives at <slug>.teamtailor.com/jobs.rss and carries a <remoteStatus> plus",
    "a structured city and country, which is better data than most JSON APIs."
  ],
  "filters": {
    "title_include": [
      "full stack",
      "fullstack",
      "full-stack",
      "frontend",
      "front end",
      "front-end",
      "web developer",
      "web engineer",
      "react",
      "javascript",
      "typescript",
      "node",
      "vue",
      "angular",
      "software engineer",
      "developer",
      "engineer",
      "backend",
      "back end",
      "back-end",
      "python",
      "java",
      "django",
      "machine learning",
      "graduate",
      "junior",
      "trainee"
    ],
    "_title_note": "A posting must match one of these to survive. Broad terms stay in so nothing good is missed; the prescore does the ranking afterwards.",
    "title_exclude": [
      "senior",
      "staff",
      "principal",
      "lead",
      "head of",
      "manager",
      "director",
      "architect",
      "sales",
      "marketing",
      "recruiter",
      "designer",
      "accountant",
      "counsel",
      "legal",
      "finance",
      "customer success",
      "account executive",
      "solutions engineer",
      "sales engineer",
      "support engineer",
      "engineering manager"
    ],
    "_exclude_note": "Bare single words match on word boundaries, so 'intern' does not eat 'International' and 'lead' does not eat 'Leadership'. Phrases with spaces or punctuation match as plain substrings. That bug once cost 351 of 352 postings.",
    "_location_note": [
      "There is deliberately no location allowlist here.",
      "Where you can work is expressed in profile.json as a home region, and",
      "applied by workMode() in scripts/fetch-jobs.mjs: remote is fine",
      "anywhere, on-site and hybrid are home only.",
      "",
      "An earlier version did use a country list. It was wrong in both",
      "directions at once: it dropped remote roles in India that were fine and",
      "kept office jobs in Amsterdam that were not."
    ]
  }
